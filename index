<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BLACKOUT: Escape the Overload</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      margin: 0;
      background: #0d1117;
      color: white;
      overflow-x: hidden;
    }

    header {
      background: #161b22;
      padding: 15px;
      text-align: center;
      border-bottom: 2px solid #00ffcc;
      position: sticky;
      top: 0;
      z-index: 999;
    }

    h1 {
      margin: 0;
      color: #00ffcc;
    }

    #timer {
      font-size: 24px;
      margin-top: 10px;
      color: #ffcc00;
    }

    .container {
      max-width: 1000px;
      margin: auto;
      padding: 20px;
    }

    .room {
      display: none;
      background: #161b22;
      padding: 20px;
      border-radius: 12px;
      margin-top: 20px;
      border: 2px solid #30363d;
      animation: fadeIn 0.5s;
    }

    .active {
      display: block;
    }
</html>
